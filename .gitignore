# Local test config - points at the mock server on 127.0.0.1. If this ever
# reached the published site every request would be blocked as mixed content
# and sync would silently stop for everyone.
config.js.mock
*.local.js

# Trip exports carry who bought what.
plate-and-parcel-trip-*.txt

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# The real config while a mock is being tested. Never commit either side of
# that swap - see the pre-commit hook, which checks the CONTENT of config.js.
config.js.ship
